# Copy to .env only for a fresh install. Existing users: KEEP your working .env!
# Groq / Qwen uses the OpenAI-compatible Chat Completions API.
CQA_LLM_PROVIDER=openai_compatible
CQA_LLM_BASE_URL=https://api.groq.com/openai/v1
CQA_LLM_API_KEY=
# Copy the exact model identifier confirmed in your GroqCloud account.
CQA_LLM_MODEL=
CQA_LLM_JSON_MODE=1
CQA_LLM_TIMEOUT=120
CQA_LLM_HTTP_RETRIES=1
CQA_LLM_FALLBACK_MODELS=
CQA_BATCH_WORKERS=1
CQA_BATCH_DELAY_SEC=12
# Fill in actual prices only when you know them.
CQA_INPUT_USD_PER_1M=0
CQA_OUTPUT_USD_PER_1M=0
# Optional private SQLite file location:
# CQA_DB_PATH=./cqa.sqlite3
