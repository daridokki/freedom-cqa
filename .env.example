# 1. Make a COPY named .env, then insert your personal Gemini key below.
# Never commit .env or the secret to a public repository.
# API endpoint and model must be accessible in your Google AI Studio project.
CQA_LLM_PROVIDER=gemini_native
# Only used for the optional OpenAI-compatible provider:
CQA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CQA_LLM_API_KEY=
CQA_LLM_MODEL=gemini-3.8-flash
CQA_LLM_JSON_MODE=1
CQA_LLM_TIMEOUT=90
# Optional comma-separated models to try if the primary one is unavailable:
CQA_LLM_FALLBACK_MODELS=

# Rate-limit friendly defaults for Gemini's free tier.
# See your ACTUAL available quotas in https://aistudio.google.com/usage
CQA_BATCH_WORKERS=1
CQA_BATCH_DELAY_SEC=8
CQA_LLM_HTTP_RETRIES=1

# Free tier: 0 USD. For paid accounts, set YOUR actual USD/1M-token rates.
CQA_INPUT_USD_PER_1M=0
CQA_OUTPUT_USD_PER_1M=0

# Optional: private database location. Defaults to ./cqa.sqlite3
# CQA_DB_PATH=./cqa.sqlite3
